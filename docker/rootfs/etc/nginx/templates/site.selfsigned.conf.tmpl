# Self-signed nginx config — used when Let's Encrypt is disabled (local-dev,
# VPN-only deploys, or when ACME would fail). The operator's domain is
# still propagated to server_name so hits to the right vhost are served —
# only the cert is the bootstrap self-signed pair.

server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}} {{CONSOLE_DOMAIN}};

    # Keep the ACME path open so a later wizard re-run can issue LE without
    # tearing down anything.
    location /.well-known/acme-challenge/ {
        root /var/lib/wantastic/letsencrypt/webroot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{DOMAIN}} {{CONSOLE_DOMAIN}};

    ssl_certificate     /etc/nginx/ssl/bootstrap.crt;
    ssl_certificate_key /etc/nginx/ssl/bootstrap.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    client_max_body_size 16M;

    location / {
        proxy_pass         http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
