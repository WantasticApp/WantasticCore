# Production nginx config — rendered by the setup wizard after it captures
# the operator's domain. {{DOMAIN}} and {{CONSOLE_DOMAIN}} are substituted
# by /usr/local/bin/nginx-render.sh. After this file lands at
# /etc/nginx/conf.d/site.conf, `nginx -s reload` activates it.

# HTTP — ACME + redirect.
server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}} {{CONSOLE_DOMAIN}};

    location /.well-known/acme-challenge/ {
        root /var/lib/wantastic/letsencrypt/webroot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS — primary portal/console.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{DOMAIN}} {{CONSOLE_DOMAIN}};

    ssl_certificate     /var/lib/wantastic/letsencrypt/live/{{DOMAIN}}/fullchain.pem;
    ssl_certificate_key /var/lib/wantastic/letsencrypt/live/{{DOMAIN}}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:WantasticSSL:10m;
    ssl_session_timeout 1d;

    # Security headers.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    client_max_body_size 16M;

    # WebSocket upgrade map (WebSSH / WebProxy / portal WS).
    location / {
        proxy_pass         http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
